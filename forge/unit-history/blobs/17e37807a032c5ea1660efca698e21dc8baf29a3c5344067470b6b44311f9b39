function applyState(id){stopTimers();closeDialog();stateSelect(id);shown=fixture.length;view='discussion';if(+id.slice(3)<=4){page='login';render();if(id==='ST-02')consent();setFragment('login');return;}if(['ST-05','ST-06','ST-07'].includes(id)){page='new';if(id==='ST-06'&&!draft)draft=locale==='uk'?'Допоможіть оцінити наш мобільний сайт.':'Help me evaluate our mobile website.';render();setFragment('discussion');return;}if(+id.slice(3)<=17){page='discussion';deleted=false;if(id==='ST-09'){beginReplay();return;}if(id==='ST-11')shown=4;render();setFragment('discussion');return;}if(+id.slice(3)<=20){page='history';if(id==='ST-18')deleted=false;render();setFragment('history');return;}if(+id.slice(3)<=25){page='settings';edit={...prefs};if(id==='ST-22')edit.speed=prefs.speed==='Thorough'?'Fast':'Thorough';if(id==='ST-23'){edit.criticModel='gpt-5.5';edit.criticReason='';}if(id==='ST-24')edit.criticProvider='Claude';render();setFragment('settings');if(id==='ST-25')sessions();return;}if(+id.slice(3)<=33){page='discussion';render();const phases={'ST-26':'permission','ST-27':'recording','ST-28':'transcribing','ST-29':'transcript','ST-30':'denied','ST-31':'missing','ST-32':'interrupted','ST-33':'failed'};voice(phases[id]);return;}if(+id.slice(3)<=36){page='discussion';view='sources';render();setFragment('sources');if(id==='ST-35')dialog('Source detail',sourceMarkup(sources[0]));return;}if(+id.slice(3)<=38){page='discussion';view='outcome';render();setFragment('outcome');return;}if(id==='ST-40'){deleted=true;page='history';render();setFragment('history');return;}if(+id.slice(3)<=42){page='discussion';deleted=false;render();setFragment('record-action');if(id==='ST-39')deleteConfirm();else if(id==='ST-41')dialog('Export conversation',`<p class="dialog-copy">Download the complete fictional example as Markdown. Your local draft and chosen filenames are excluded.</p><div class="dialog-actions"><button data-action="close">Cancel</button><button class="primary" data-action="export">Do