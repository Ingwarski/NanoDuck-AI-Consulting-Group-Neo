<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="dark"><link rel="icon" href="./nanoduck.svg" type="image/svg+xml"><title>NanoDuck Consulting Group · Prismatic — Combined consulting design</title><link rel="stylesheet" href="./styles.css"><script src="./app.js" defer></script></head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="navbar">
<button class="brand" data-page="discussion" aria-label="NanoDuck Consulting Group — Discussion"><img class="brand-mark" src="./nanoduck.svg" alt="" width="40" height="40"><span class="brand-name">NanoDuck<span class="brand-subtitle">Consulting Group</span></span></button>
<nav class="desktop-nav" aria-label="Main navigation"><button data-page="discussion">Discussion</button><button data-page="history">Conversations</button><button data-page="settings">Settings</button></nav>
<button id="menu-button" class="menu-button" aria-expanded="false" aria-controls="mobile-menu"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>Menu</button>
<nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" hidden><button data-page="discussion">Discussion</button><button data-page="history">Conversations</button><button data-page="settings">Settings</button></nav>
</header>
<div class="workspace-actions"><span class="workspace-label">Your workspace</span><button data-page="new" class="new-conversation"><span aria-hidden="true">+</span> New</button></div>
<aside id="review-inspector" class="review-inspector" aria-label="Design inspection controls" hidden><strong>Prototype inspection</strong><div class="review-fields"><label for="preview-state">Screen state<select id="preview-state"></select></label><label for="preview-locale">Conversation language<select id="preview-locale"><option value="en">English</option><option value="uk">Українська</option></select></label><small>Fictional states only. Voice is simulated; no microphone access.</small></div></aside>
<main id="main" tabindex="-1"><div id="page-content"></div>
<section id="composer" class="composer" aria-label="Message composer"><div class="composer-top"><span id="composer-status">Example complete · One assumption to test</span><div><button id="stop-button" data-action="stop" class="compact" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7h10v10H7z"/></svg>Stop</button><button id="continue-button" data-action="continue" class="compact" hidden>Continue example</button></div></div><form id="composer-form"><label for="message" class="sr-only">Message</label><textarea id="message" rows="2" placeholder="Add your point of view…"></textarea><div id="attachment-list" class="attachment-list"></div><div class="composer-tools"><div class="input-tools"><button type="button" data-action="attach" aria-label="Attach image or PDF" title="Attach image or PDF"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 13 6-6a3 3 0 0 1 4 4l-8 8a5 5 0 0 1-7-7l9-9M7 14l7-7"/></svg></button><input id="attachment" type="file" accept="image/png,image/jpeg,image/webp,application/pdf" multiple hidden><button id="voice-button" type="button" data-action="voice" aria-label="Voice input" title="Voice input"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="12" rx="3"/><path d="M5 11v1a7 7 0 0 0 14 0v-1M12 19v3M8 22h8"/></svg></button></div><button id="send-button" type="submit" class="primary">Send<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></button></div></form><p class="composer-note" id="draft-note">Sample only · No message will be sent to a service</p></section></main>
<footer class="page-footer"><span>Design preview · Fictional discussion · No live services</span><span>C · Prismatic · v5</span></footer>
<dialog id="dialog" aria-labelledby="dialog-title"><div class="dialog-header"><h2 id="dialog-title"></h2><button data-action="close-dialog" class="icon-button" aria-label="Close dialog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div><div id="dialog-body"></div></dialog>
<div id="toast" role="status" hidden></div>
</body></html>
